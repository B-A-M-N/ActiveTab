{
  "name": "active-tab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first native browser navigation runtime built on CDP",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local src/cli.js",
    "mcp": "node --env-file-if-exists=.env.local src/mcp/server.js",
    "mcp:extension": "node --env-file-if-exists=.env.local src/extension/start-mcp.js",
    "native-host:setup": "node scripts/install-native-host.js",
    "test": "node --test",
    "api": "node --env-file-if-exists=.env.local src/api/start-server.js",
    "api:test": "node --test test/api-server.test.js",
    "test:headed": "bash scripts/test-headed.sh",
    "qualify:model-visual": "node --env-file-if-exists=.env.local scripts/qualify-model-visual.mjs",
    "qualify:secondary": "node --env-file-if-exists=.env.local scripts/qualify-model-visual.mjs --secondary-only",
    "qualify:jev-visual": "node --env-file-if-exists=.env.local scripts/qualify-model-visual.mjs --jev-only",
    "qualify:public-sites": "node --env-file-if-exists=.env.local scripts/qualify-public-sites.mjs",
    "pretest:secondary": "node --env-file-if-exists=.env.local scripts/qualify-model-visual.mjs --secondary-only",
    "pretest:jev-visual": "node --env-file-if-exists=.env.local scripts/qualify-model-visual.mjs --jev-only",
    "pretest:multimodal": "node --env-file-if-exists=.env.local scripts/qualify-model-visual.mjs",
    "benchmark:semantic-observation": "node scripts/benchmark-semantic-observation.mjs",
    "qualify:staging": "node --env-file-if-exists=.env.local scripts/qualify-staging.mjs",
    "qualify:staging:owned": "node --env-file-if-exists=.env.local scripts/qualify-staging.mjs --mode=owned",
    "browser:staging": "node --env-file-if-exists=.env.local scripts/qualify-staging.mjs --mode=owned --open-only",
    "qualify:staging:attached": "node --env-file-if-exists=.env.local scripts/qualify-staging.mjs --mode=attached",
    "discover:staging-dashboard": "node --env-file-if-exists=.env.local scripts/discover-staging-dashboard.mjs",
    "discover:staging-admin-console": "node --env-file-if-exists=.env.local scripts/discover-staging-admin-console.mjs",
    "discover:staging-admin-config": "node --env-file-if-exists=.env.local scripts/discover-staging-admin-config.mjs",
    "discover:staging-admin": "node --env-file-if-exists=.env.local scripts/discover-staging-admin.mjs",
    "discover:staging-admin:settings": "node --env-file-if-exists=.env.local scripts/discover-staging-admin.mjs --recipe=admin-settings-review",
    "pretest:secondary-image": "node --env-file-if-exists=.env.local scripts/qualify-model-visual.mjs --secondary-image-only"
  }
}
