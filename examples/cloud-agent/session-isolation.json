{
  "workflow_id": "cloud-agent-session-isolation",
  "name": "Session isolation",
  "description": "Verify that independently owned sessions, threads, connectors, and jobs cannot interfere.",
  "profile_id": "cloud-agent-staging",
  "mode": "test",
  "requires": [
    "test_owned_resource",
    "multiple_sessions"
  ],
  "steps": [
    {
      "id": "s1",
      "type": "setup"
    },
    {
      "id": "s2",
      "type": "assert",
      "assertion": {
        "type": "diagnostic_source_available",
        "sourceId": "cloud-agent-execution-history"
      }
    },
    {
      "id": "s3",
      "type": "diagnostic_snapshot"
    },
    {
      "id": "s4",
      "type": "cleanup"
    }
  ],
  "template": true,
  "executable": false
}
