{
  "workflow_id": "cloud-agent-smoke",
  "name": "Cloud Agent smoke test",
  "description": "Verify login state, application availability, route navigation, visible controls, and available status endpoints.",
  "profile_id": "cloud-agent-staging",
  "mode": "observe",
  "steps": [
    {
      "id": "s1",
