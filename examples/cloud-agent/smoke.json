    },
    {
      "id": "s2",
      "type": "assert",
      "assertion": {
        "type": "page_title_contains",
        "value": "cloud"
      }
    },
    {
      "id": "s3",
      "type": "diagnostic_snapshot"
    },
    {
      "id": "s4",
      "type": "cleanup"
    }
  ],
  "template": true,
  "executable": false
}
