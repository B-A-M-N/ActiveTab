{
  "manifest_version": 3,
  "name": "ActiveTab",
  "version": "0.1.0",
  "description": "Explicitly attach ActiveTab to the current Chrome tab for local native CDP control.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": ["activeTab", "debugger", "nativeMessaging", "storage"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Attach ActiveTab" }
}
