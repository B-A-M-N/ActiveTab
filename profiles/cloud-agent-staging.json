{
  "$schema": "./profile-schema.json",
  "profile_id": "cloud-agent-staging",
  "name": "Cloud Agent on FreeInference Staging",
  "description": "Cloud Agent is reached from the authenticated FreeInference staging website by following its visible Cloud Agents link. Its destination may use a different URL; the browser observes that destination instead of guessing it. Backend diagnostics use a separate optional adapter.",
  "environment": {
    "environment_id": "freeinference-staging",
    "platform": "freeinference",
    "application_entry_url": "https://staging.freeinference.org",
    "browser_control_endpoint": null,
    "diagnostic_endpoint": null,
    "diagnostic_transport": null,
    "remote_target": null,
    "authorized_origins": ["https://staging.freeinference.org", "https://agents-staging.freeinference.org"],
    "applications": [
      {
        "application_id": "fi-agents",
        "authentication_realm": "agents-session",
        "candidate_entry": "https://agents-staging.freeinference.org/",
        "status": "candidate"
      }
    ]
  },
  "origin_patterns": ["https://staging.freeinference.org", "https://agents-staging.freeinference.org"],
  "authentication_realms": [
    {
      "realm_id": "agents-session",
      "description": "Agents/Cloud Agent application session. Distinct from the FreeInference dashboard session: verify it independently and never copy dashboard credentials or tokens into this realm.",
      "scope": ["agents_app"],
      "separate_credentials": true
    },
    {
      "realm_id": "fi-admin",
      "description": "FreeInference dashboard admin session. Authorizes admin diagnostic surfaces only; it does not authorize Cloud Agent internal tools or the Agents application realm.",
      "scope": ["fi_dashboard_admin"],
      "separate_credentials": true
    }
  ],
  "diagnostic_sources": [
    {
      "source_id": "cloud-agent-admin-ui-inventory",
      "description": "Bounded, read-only inventory of the authenticated Cloud Agent admin UI and same-origin GET routes it loads.",
      "authority": "admin_session",
      "operations": ["read_ui_metadata", "observe_get_routes"],
      "scope": "profile-declared-surfaces",
      "sensitivity": "metadata_only",
      "validation_required": true,
      "notes": "Uses visible UI links and controls only. Does not read response bodies, submit admin forms, or query database tables."
    },
    {
      "source_id": "cloud-agent-runs",
      "description": "Recent agent run execution records, scoped to the test operation under investigation.",
      "authority": "admin_session",
      "operations": ["read"],
      "scope": "run-scoped",
      "sensitivity": "metadata_only",
      "validation_required": true,
      "notes": "Retrieved via the Cloud Agent admin diagnostic adapter (optional backend source), never via the browser entry URL."
    },
    {
      "source_id": "cloud-agent-execution-history",
      "description": "Execution history visible in the Agents application UI. Discovery is required.",
      "authority": "application_session",
      "operations": ["read"],
      "scope": "run-scoped",
      "sensitivity": "metadata_only",
      "validation_required": true
    },
    {
      "source_id": "cloud-agent-worker-status",
      "description": "Worker and scheduling diagnostics, if exposed. Aggregate only.",
      "authority": "admin_session",
      "operations": ["read_aggregate"],
      "scope": "aggregate",
      "sensitivity": "metadata_only",
      "validation_required": true
    }
  ],
  "staging_ui_diagnostics": {
    "application_origin": "https://agents-staging.freeinference.org",
    "entry_link_labels": ["Agents", "Cloud Agents"],
    "login_link_labels": ["Login", "Log in", "Sign in"],
    "admin_link_labels": ["Admin"],
    "settings_link_labels": ["Settings"],
    "admin_path_prefix": "/admin/",
    "api_path_prefix": "/api/admin/agent/",
    "surfaces": [
      { "surface_id": "audit", "pathname": "/admin/audit", "link_labels": ["Audit", "Audit log"], "audit_categories": ["All", "Settings", "Servers", "Measurements", "Content views", "Database"] },
      { "surface_id": "activity", "pathname": "/admin/activity", "link_labels": ["Activity"], "tabs": ["Sandboxes", "Sessions", "Turns", "Steps"], "known_options": ["Last 7 days", "Last 30 days", "Last 90 days", "All results", "queued", "running", "succeeded", "failed", "cancelled"] },
      { "surface_id": "measurements", "pathname": "/admin/measurements", "link_labels": ["Measurements"], "expandable_sections": ["Operations", "Timings"], "known_options": ["All Operations", "Sandbox Startup", "Terminal Opening", "File Listing", "File Opening", "All servers"] },
      { "surface_id": "usage", "pathname": "/admin/usage", "link_labels": ["Usage"], "known_options": ["Last 7 days", "Last 30 days", "Last 90 days"] },
      { "surface_id": "database", "pathname": "/admin/database", "link_labels": ["Database"], "known_options": ["agent_audit", "agent_jobs", "agent_attempts", "agent_sandboxes", "agent_threads", "agent_tool_resources", "Ascending", "Descending", "25", "50", "100", "200"] },
      { "surface_id": "settings", "pathname": null, "link_labels": ["Settings"], "route_discovery": "visible-admin-link", "status": "needs-live-inventory" }
    ],
    "known_controls": ["Operation", "Run", "Server", "Servers", "Created", "Turn created", "Turn result", "Rows per page", "Sort by", "Sort direction", "Add filter"],
    "known_options": ["All", "Settings", "Servers", "Measurements", "Content views", "Database", "Sandboxes", "Sessions", "Turns", "Steps", "All operations", "All Operations", "Sandbox Startup", "Terminal Opening", "File Listing", "File Opening", "All servers", "All results", "Last 7 days", "Last 30 days", "Last 90 days", "queued", "running", "succeeded", "failed", "cancelled", "agent_audit", "agent_jobs", "agent_attempts", "agent_sandboxes", "agent_threads", "agent_tool_resources", "Ascending", "Descending", "25", "50", "100", "200"],
    "recipes": [
      { "recipe_id": "admin-dashboard-inventory", "areas": ["audit", "activity", "measurements", "usage", "database", "settings"] },
      { "recipe_id": "admin-settings-review", "areas": ["settings"] },
      { "recipe_id": "admin-activity-review", "areas": ["activity", "measurements", "usage"] },
      { "recipe_id": "admin-audit-review", "areas": ["audit"] }
    ],
    "policy": {
      "maximumRowsExpandedPerAuditCategory": 1,
      "maximumPages": 6,
      "readOnly": true,
      "recordPageText": false,
      "readResponseBodies": false,
      "submitForms": false,
      "selectDatabaseTables": false,
      "recordFreeTextFieldValues": false,
      "allowOnlyVisibleAdminLinks": true
    }
  },
  "test_packs": []
}
